{
  "name": "loopstack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vite.config.ts",
    "dashboard": "node scripts/publish-dashboard.mjs",
    "system:review": "node scripts/system/review.mjs",
    "system:test": "node --test scripts/system/test/*.mjs",
    "system:mcp": "node scripts/system/mcp.mjs",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:web": "tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts --mode web",
    "desktop:build": "tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "desktop:app": "node desktop/scripts/app.mjs",
    "desktop:dist": "npm run desktop:build && npm --prefix desktop run dist",
    "desktop:test": "vitest run --config desktop/vite.config.ts && node --test desktop/electron/test/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "^8.4.7",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.150.0"
  }
}
